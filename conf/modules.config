/*
    Output layout. Two paths are a CONTRACT with SCRATCH-TCRmerge (receptor = BCR), which
    derives them from the dataset root on Cirro - do not move them:

        bridge/merged_bcr_object/post_qc_cells.tsv   (+ pre_qc_*, summaries, .rds)
        BCR_QC/tables/contigs_{before,after}_qc.tsv

    and Cell Ranger outputs keep <sample>/outs/airr_rearrangement.tsv, from which TCRmerge
    takes full contig sequences.
*/

process {
    withName: 'SAMPLESHEET_CHECK' {
        publishDir = [ path: { "${params.outdir}/pipeline_info" }, mode: params.publish_mode, overwrite: true ]
    }
    withName: 'CELLRANGER_VDJ' {
        publishDir = [ path: { "${params.outdir}/cellranger" }, mode: params.publish_mode, overwrite: true,
                       pattern: '*/outs/*' ]
    }
    withName: 'CHANGEO_ANNOTATE' {
        publishDir = [ path: { "${params.outdir}/immcantation/annotate" }, mode: params.publish_mode, overwrite: true,
                       pattern: '*_db-{pass,fail}.tsv' ]
    }
    withName: 'BCR_QC' {
        publishDir = [ path: { "${params.outdir}/BCR_QC/per_sample" }, mode: params.publish_mode, overwrite: true ]
    }
    withName: 'BCR_QC_COLLECT' {
        publishDir = [ path: { "${params.outdir}/BCR_QC/tables" }, mode: params.publish_mode, overwrite: true ]
    }
    withName: 'DEFINE_CLONES' {
        publishDir = [ path: { "${params.outdir}/immcantation/clones" }, mode: params.publish_mode, overwrite: true ]
    }
    withName: 'GERMLINE_SHM' {
        publishDir = [ path: { "${params.outdir}/immcantation/germline_shm" }, mode: params.publish_mode, overwrite: true ]
    }
    withName: 'LINEAGE' {
        publishDir = [ path: { "${params.outdir}/immcantation/lineage" }, mode: params.publish_mode, overwrite: true ]
    }
    withName: 'BCR_OBJECT' {
        publishDir = [ path: { "${params.outdir}/bridge/merged_bcr_object" }, mode: params.publish_mode, overwrite: true ]
    }
    withName: 'ATTACH_GEX' {
        publishDir = [ path: { "${params.outdir}/seurat" }, mode: params.publish_mode, overwrite: true ]
    }
}
