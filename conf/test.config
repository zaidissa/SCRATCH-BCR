/*
    Stub test: checks channel wiring, samplesheet validation and publishing end to end
    without containers, references or real data.

        nextflow run . -profile test -stub

    assets/test/samplesheet.csv mixes BCR, GEX and TCR rows across two lanes and two
    patients, so the modality filter, lane grouping and per-subject grouping are all
    exercised. The FASTQs are empty placeholders - only stubs ever see them.
*/

docker.enabled = false

params {
    input         = "${projectDir}/assets/test/samplesheet.csv"
    outdir        = 'results_test'
    vdj_reference = "${projectDir}/assets/test/vdj_reference"
    max_cpus      = 2
    max_memory    = '6.GB'
    max_time      = '1.h'
}

process {
    cpus   = 1
    memory = '1.GB'
}
