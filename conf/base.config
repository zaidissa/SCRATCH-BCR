/*
    Resource model - same labels and escalation as SCRATCH-E2E's conf/base.config, so the
    two pipelines size tasks the same way on Cirro.
*/

process {

    cpus   = { 1    * task.attempt }
    memory = { 6.GB * task.attempt }
    time   = { 4.h  * task.attempt }

    resourceLimits = [
        cpus  : params.max_cpus,
        memory: params.max_memory as nextflow.util.MemoryUnit,
        time  : params.max_time   as nextflow.util.Duration
    ]

    // Signal-related exits (OOM kill, segfault, LSF/Slurm memory kill) retry with more.
    errorStrategy = { task.exitStatus in [104,130,134,137,139,140,143,247] ? 'retry' : 'finish' }
    maxRetries    = 2
    maxErrors     = '-1'

    // On-demand, not spot - SCRATCH-E2E measured a reclaimed host throwing away long
    // tasks; Cell Ranger and IgPhyML lineage runs are the long tasks here. A selector,
    // because Cirro's general `queue` setting would otherwise override it. Off Cirro both
    // variables are unset and executors that ignore `queue` are unaffected.
    withName: '.*' {
        queue = System.getenv('PW_ONDEMAND_JOB_QUEUE') ?: System.getenv('PW_SPOT_JOB_QUEUE')
    }

    withLabel: process_single {
        cpus   = { 1     * task.attempt }
        memory = { 6.GB  * task.attempt }
        time   = { 4.h   * task.attempt }
    }
    withLabel: process_low {
        cpus   = { 2     * task.attempt }
        memory = { 12.GB * task.attempt }
        time   = { 6.h   * task.attempt }
    }
    withLabel: process_medium {
        cpus   = { 8     * task.attempt }
        memory = { 32.GB * task.attempt }
        time   = { 12.h  * task.attempt }
    }
    withLabel: process_high {
        cpus   = { 16    * task.attempt }
        memory = { 64.GB * task.attempt }
        time   = { 24.h  * task.attempt }
    }
    withLabel: process_high_memory {
        cpus   = { 4      * task.attempt }
        memory = { 128.GB * task.attempt }
        time   = { 12.h   * task.attempt }
    }
    // Trees: CPU-bound, scales with clone count; IgPhyML can run for hours.
    withLabel: process_lineage {
        cpus   = { 16    * task.attempt }
        memory = { 32.GB * task.attempt }
        time   = { (params.lineage_build == 'igphyml' ? 48.h : 12.h) * task.attempt }
    }

    // Cell Ranger VDJ: same sizing SCRATCH-E2E uses.
    withName: 'CELLRANGER_VDJ' {
        cpus   = { 8     * task.attempt }
        memory = { 32.GB * task.attempt }
        time   = { 12.h  * task.attempt }
    }
}
