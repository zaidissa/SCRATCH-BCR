/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    SCRATCH-BCR - configuration
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Docker is enabled globally, as in SCRATCH-TCRmerge: Cirro launches with no -profile.
    The `test` profile (stub run, no containers) is for checking the wiring locally.
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

params {
    // ── input ────────────────────────────────────────────────────────────────
    input            = null          // samplesheet CSV (see README)
    input_type       = 'fastq'       // fastq | cellranger (existing filtered_contig_* files)
    outdir           = 'results'
    project_name     = 'bcr'
    publish_mode     = 'copy'

    // ── reference ────────────────────────────────────────────────────────────
    genome           = 'GRCh38'      // GRCh38 (human) | GRCm39 (mouse)
    species          = null          // human | mouse; null = derived from genome
    igenomes_base    = "${projectDir}/references"
    vdj_reference    = null          // overrides genomes.<genome>.vdj
    // The 10x VDJ reference contains TR AND IG segments: the same directory serves
    // SCRATCH-E2E's TCR alignment and this pipeline.
    genomes {
        'GRCh38' { vdj = "${params.igenomes_base}/refdata-cellranger-vdj-GRCh38-alts-ensembl-7.1.0" }
        'GRCm39' { vdj = "${params.igenomes_base}/refdata-cellranger-vdj-GRCm38-alts-ensembl-7.0.0" }
    }
    vdj_chain        = 'IG'
    // IgBLAST database and IMGT references as laid out inside immcantation/suite.
    igblast_db       = '/usr/local/share/igblast'
    imgt_germlines   = '/usr/local/share/germlines/imgt'
    igphyml_exec     = '/usr/local/share/igphyml/src/igphyml'

    // ── BCR QC ───────────────────────────────────────────────────────────────
    bcr_min_umis          = 1
    bcr_productive_only   = true
    bcr_drop_multi_heavy  = true     // >1 productive heavy chain per cell = likely doublet
    bcr_require_heavy     = true     // light-only cells cannot be clonally assigned
    bcr_multi_light       = 'keep_top'   // keep_top | drop_cell | keep_all
    skip_failed_samples   = true     // a sample whose Cell Ranger run fails (bad FASTQ) is skipped, the rest finish

    // ── clones ───────────────────────────────────────────────────────────────
    clone_by                  = 'patient_id'   // samplesheet column grouping samples for clone calling
    clone_method              = 'hierarchical' // hierarchical (SCOPer) | identical
    clonal_threshold          = 'auto'         // auto (SHazaM fit) or a number, e.g. 0.15
    clonal_threshold_fallback = 0.15           // used when the auto fit has too little data
    clonal_threshold_warn_above = 0.25         // fitted threshold above this: WARN (may merge unrelated cells)
    clonal_threshold_warn_below = 0.05         // fitted threshold below this: WARN (may split real clones)
    clonal_threshold_subsample  = 5000         // threshold fit: max junctions compared per V/J/length group (0 = all)

    // ── SHM + lineage (both on by default) ───────────────────────────────────
    run_shm              = true
    shm_unmutated_cutoff = 0.01      // heavy mu_freq below this -> shm_status 'unmutated'
    run_lineage          = true
    lineage_build        = 'pratchet'    // pratchet (minutes) | pml | igphyml (hours)
    lineage_min_seqs     = 3
    lineage_max_clones   = 500           // trees for the N largest clones per patient; 0 = every eligible clone
    lineage_chain        = 'auto'        // auto | HL | H
    lineage_plot_top     = 10

    // ── optional: attach BCR onto a GEX Seurat object ────────────────────────
    input_gex_object = null          // .rds Seurat (SCRATCH-E2E); large cohorts: use TCRmerge on .h5ad
    obs_prefix       = 'bcr_'
    library_tokens   = 'GEX,TCR,VDJ,BCR,ADT'
    min_match_rate   = 0.01

    // ── containers ───────────────────────────────────────────────────────────
    container_cellranger   = 'syedsazaidi/cellranger:v9.0.1'      // SCRATCH-E2E's image
    container_immcantation = 'immcantation/suite:4.5.0'           // IgBLAST, Change-O, SHazaM, SCOPer, dowser, IgPhyML
    container_sc           = 'syedsazaidi/scratch-tcr:latest'     // TCRtoolkit's sc image: Seurat, scRepertoire

    // ── resources (ceilings) ─────────────────────────────────────────────────
    max_cpus   = 32
    max_memory = '240.GB'
    max_time   = '240.h'
}

docker {
    enabled    = true
    runOptions = '-u $(id -u):$(id -g)'
}

includeConfig 'conf/base.config'
includeConfig 'conf/modules.config'

profiles {
    // Wiring check: every process runs its stub, no containers, no references.
    //   nextflow run . -profile test -stub
    test  { includeConfig 'conf/test.config' }
    // Apple Silicon Mac: the Cell Ranger and Immcantation images are x86_64 only and
    // run under Rosetta. Combine with --max_cpus / --max_memory sized to Docker Desktop.
    arm64 {
        docker.runOptions = '--platform linux/amd64 -u $(id -u):$(id -g)'
    }
    // Laptop/HPC without Docker: use Singularity/Apptainer with the same images.
    singularity {
        docker.enabled          = false
        singularity.enabled     = true
        singularity.autoMounts  = true
    }
}

manifest {
    name            = 'SCRATCH-BCR'
    description     = 'Single-cell BCR processing (10x VDJ-B) with Immcantation, emitting per-cell objects that merge with SCRATCH-E2E (GEX) and TCRtoolkit (TCR)'
    mainScript      = 'main.nf'
    nextflowVersion = '>=23.10.0'
    version         = '0.1.0'
}

timeline { enabled = true; file = "${params.outdir}/pipeline_info/timeline.html"; overwrite = true }
report   { enabled = true; file = "${params.outdir}/pipeline_info/report.html";   overwrite = true }
trace    { enabled = true; file = "${params.outdir}/pipeline_info/trace.tsv";     overwrite = true }
