/*
    Cirro compute overrides for BCR-Pipeline.

    Cirro supplies the executor, queue and work directory; this file carries the
    reference layout and the ceilings. The reference bucket and paths are the ones
    SCRATCH-E2E's .cirro/process-compute.config uses for its TCR alignment - the 10x
    VDJ reference holds IG segments too, so the same directory serves BCR.
    CONFIRM the bucket path before the first FASTQ run; nothing here can check it.
*/

process {
    executor      = 'awsbatch'
    errorStrategy = 'retry'
    maxRetries    = 2
}

params.igenomes_base = 's3://btc-refdata/scratch'

params {
    genomes {
        'GRCh38' { vdj = "${params.igenomes_base}/refdata-cellranger-vdj-GRCh38-alts-ensembl-7.1.0" }
        'GRCm39' { vdj = "${params.igenomes_base}/refdata-cellranger-vdj-GRCm38-alts-ensembl-7.0.0" }
    }
    max_cpus   = 32
    max_memory = '240.GB'
    max_time   = '240.h'
}

// conf/base.config computed resourceLimits from params.max_* while nextflow.config was
// being read, before this file - so changing max_* above alone would not move the
// ceiling. Set it directly as well (values from the form's max_* still win, because
// Cirro passes form values as params before any config is read).
process.resourceLimits = [ cpus: 32, memory: 240.GB, time: 240.h ]
